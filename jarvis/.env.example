# Copy to .env and fill in. Nothing here is required for --mock mode.

# --- Principal -------------------------------------------------------------
JARVIS_PRINCIPAL_NAME="Mr. Ozekin"
JARVIS_PRINCIPAL_EMAIL="martin@orbit3.io"

# --- Google OAuth2 (Gmail read-only) ---------------------------------------
# Download an OAuth "Desktop app" client from Google Cloud Console and save it as
# credentials.json (see README). token.json is written after the first login.
GOOGLE_CREDENTIALS_PATH="credentials.json"
GOOGLE_TOKEN_PATH="token.json"

# --- Auravest ----------------------------------------------------------------
AURAVEST_SENDER="support@auravest.ai"
AURAVEST_LOOKBACK_DAYS=1

# --- Orbit3 task digest -----------------------------------------------------
ORBIT3_LOOKBACK_DAYS=3

# --- Weather (Open-Meteo, no key needed) -------------------------------------
WEATHER_LATITUDE=-33.8688
WEATHER_LONGITUDE=151.2093
WEATHER_TIMEZONE="Australia/Sydney"
WEATHER_LOCATION_NAME="Sydney, NSW"

# --- ElevenLabs voice ----------------------------------------------------------
ELEVENLABS_API_KEY=""
# "Daniel" - a British, measured, authoritative premade voice. Override with any
# voice id from your library (try:  jarvis --list-voices  to find a butler).
ELEVENLABS_VOICE_ID="onwK4e9ZLuTAKqWW03F9"
ELEVENLABS_MODEL_ID="eleven_turbo_v2_5"

# --- Audio ---------------------------------------------------------------------
# Optional explicit player command for streamed audio (stdin). Auto-detected if empty.
# e.g. "ffplay -nodisp -autoexit -loglevel quiet -i pipe:0" or "mpv --no-video -"
JARVIS_AUDIO_PLAYER=""
